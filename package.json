{
  "name": "tedicross",
  "version": "0.12.4",
  "description": "Bridging Telegram and Discord",
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TediCross/TediCross.git"
  },
  "scripts": {
    "build": "tsc",
    "postinstall": "npm run build",
    "start": "node dist/main.js",
    "start:dev": "nodemon --watch 'src/**/*.ts' --exec ts-node src/main.ts -i data/",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint --fix src/**/*.ts",
    "clean": "rimraf dist/"
  },
  "dependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@types/js-yaml": "4.0.9",
    "@types/ramda": "0.32.0",
    "@types/semver": "7.8.0",
    "@types/underscore": "1.13.0",
    "@types/yargs": "17.0.35",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "cli-highlight": "2.1.11",
    "discord.js": "14.27.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "js-yaml": "5.4.2",
    "mime": "4.1.0",
    "moment": "2.31.0",
    "nodemon": "3.1.14",
    "ogg-opus-decoder": "1.7.5",
    "prettier": "3.9.9",
    "ramda": "0.32.0",
    "rimraf": "6.1.3",
    "semver": "7.8.5",
    "simple-markdown": "0.7.3",
    "sqlite": "5.1.1",
    "sqlite3": "6.0.1",
    "telegraf": "4.16.3",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "underscore": "1.13.8",
    "yargs": "18.2.0"
  }
}
