{
	"name": "tedicross",
	"version": "1.0.0",
	"description": "Bridging Telegram and Discord",
	"engines": {
		"node": ">=22.13"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TediCross/TediCross.git"
	},
	"author": {
		"name": "TediCross Team",
		"url": "https://github.com/TediCross"
	},
	"scripts": {
		"build": "tsc",
		"start": "node dist/main.js",
		"start:dev": "nodemon --watch 'src/**/*.ts' --exec ts-node src/main.ts -i data/",
		"lint": "eslint src/**/*.ts",
		"lint:fix": "eslint --fix src/**/*.ts",
		"clean": "rimraf dist/"
	},
	"dependencies": {
		"discord.js": "14.27.0",
		"js-yaml": "5.4.2",
		"mime": "4.1.0",
		"moment": "2.31.0",
		"ogg-opus-decoder": "1.7.5",
		"ramda": "0.32.0",
		"semver": "7.8.5",
		"simple-markdown": "0.7.3",
		"sqlite": "5.1.1",
		"sqlite3": "6.0.1",
		"telegraf": "4.16.3",
		"underscore": "1.13.8",
		"yargs": "18.2.0"
	},
	"devDependencies": {
		"@eslint/eslintrc": "3.3.7",
		"@eslint/js": "10.0.1",
		"@types/js-yaml": "4.0.9",
		"@types/ramda": "0.32.0",
		"@types/semver": "7.8.0",
		"@types/underscore": "1.13.0",
		"@types/yargs": "17.0.35",
		"@typescript-eslint/eslint-plugin": "8.71.0",
		"@typescript-eslint/parser": "8.71.0",
		"cli-highlight": "2.1.11",
		"eslint": "10.11.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-prettier": "5.5.6",
		"nodemon": "3.1.14",
		"prettier": "3.9.9",
		"rimraf": "6.1.3",
		"ts-node": "10.9.2",
		"typescript": "6.0.3"
	},
	"allowScripts" : {
		"sqlite3": true
	}
}
